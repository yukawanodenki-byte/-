<%- include('header', { title: '案件を追加' }) %>
<h1>案件を追加</h1>
<div class="card" style="max-width:520px;">
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="post" action="/projects">
    <label>案件名 *</label>
    <input type="text" name="name" required>
    <label>発注機関</label>
    <input type="text" name="agency">
    <label>契約金額</label>
    <input type="text" name="contract_amount" placeholder="例: 12,000,000円（税込）">
    <label>工期</label>
    <input type="text" name="period_text" placeholder="例: 2026/09/01 〜 2027/02/28">
    <label>作成担当者</label>
    <select name="assignee_user_id">
      <option value="">未設定</option>
      <% users.forEach(function (u) { %>
        <option value="<%= u.id %>"><%= u.display_name %></option>
      <% }) %>
    </select>

    <div class="lowbid-toggle-wrap" style="margin-top:16px;">
      <button type="button" class="btn secondary lowbid-toggle-btn">🔻 低入札案件として登録</button>
      <input type="hidden" name="is_low_bid" class="lowbid-toggle-input" value="false">
      <p class="helptext lowbid-toggle-help" style="display:none;">低入札価格調査で一般的に求められる書類（16項目）を、必須書類とは別の専用リストとして案件詳細ページに追加します。実際に必要な書類は発注機関の指示に必ず従って確認してください。落札後に低入札対象と判明した場合は、案件詳細ページの基本情報からも後で切り替えられます。</p>
    </div>

    <div style="margin-top:16px;">
      <button class="btn" type="submit">作成</button>
      <a class="btn secondary" href="/">キャンセル</a>
    </div>
  </form>
</div>
<%- include('footer') %>
