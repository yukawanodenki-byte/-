<%- include('header', { title: project.name }) %>
<div style="display:flex;justify-content:space-between;align-items:flex-start;">
  <h1><%= project.name %></h1>
  <span class="save-indicator" id="saveIndicator"></span>
</div>
<p><a href="/">← 案件一覧に戻る</a></p>

<div class="card">
  <h2>基本情報</h2>
  <form method="post" action="/projects/<%= project.id %>/info">
    <label>案件名</label>
    <input type="text" name="name" value="<%= project.name %>">
    <label>発注機関</label>
    <input type="text" name="agency" value="<%= project.agency || '' %>">
    <label>契約金額</label>
    <input type="text" name="contract_amount" value="<%= project.contract_amount || '' %>">
    <label>工期</label>
    <input type="text" name="period_text" value="<%= project.period_text || '' %>">
    <label>共有フォルダのリンク</label>
    <input type="text" name="folder_url" value="<%= project.folder_url || '' %>" placeholder="例: \\server\projects\〇〇工事 または https://...">
    <p class="helptext">全員が使っている共有サーバー上のこの案件のフォルダへのリンクです。保存すると案件一覧・このページ上部からすぐ開けます。</p>
    <div style="margin-top:12px;">
      <button class="btn" type="submit">保存</button>
      <button class="btn secondary" type="submit" formaction="/projects/<%= project.id %>/archive"
        onclick="return confirm('この案件をアーカイブしますか？一覧から非表示になります。')">アーカイブ</button>
    </div>
  </form>
  <% if (project.folder_url) { %>
    <div style="margin-top:12px;">
      <a class="btn secondary" href="<%= project.folder_url %>" target="_blank" rel="noopener">📁 共有フォルダを開く</a>
    </div>
  <% } %>
</div>

<div class="card">
  <h2>体制・工程</h2>
  <div class="tech-grid">
    <% ['監理技術者','主任技術者','現場代理人'].forEach(role => {
      const t = techMap[role] || {};
    %>
      <div class="tech-col" data-role="<%= role %>" data-project="<%= project.id %>">
        <h4><%= role %></h4>
        <label>氏名</label>
        <input type="text" class="tech-name" value="<%= t.person_name || '' %>" placeholder="未配置なら × など">
        <div class="switch">
          <label style="margin:0;display:flex;align-items:center;gap:4px;">
            <input type="radio" name="exclusive-<%= role %>" class="tech-exclusive" value="true" <%= (t.exclusive === undefined || t.exclusive) ? 'checked' : '' %>> 専任
          </label>
          <label style="margin:0;display:flex;align-items:center;gap:4px;">
            <input type="radio" name="exclusive-<%= role %>" class="tech-exclusive" value="false" <%= (t.exclusive === false) ? 'checked' : '' %>> 非専任
          </label>
        </div>
        <div class="dates">
          <div>
            <label>開始日</label>
            <input type="date" class="tech-start" value="<%= t.start_date ? t.start_date.toISOString().slice(0,10) : '' %>">
          </div>
          <div>
            <label>終了日</label>
            <input type="date" class="tech-end" value="<%= t.end_date ? t.end_date.toISOString().slice(0,10) : '' %>">
          </div>
        </div>
      </div>
    <% }) %>
  </div>
  <p class="helptext">同一氏名の技術者が期間の重なる複数案件に配置されている場合、案件一覧にバッジで表示されます（専任同士＝赤、非専任同士＝青）。</p>
</div>

<div class="card">
  <h2>必須書類</h2>
  <div class="doc-grid-v2">
    <% REQUIRED_DOC_KEYS.forEach(key => {
      const d = docsMap[key] || { status: 'not_started', link_url: '' };
    %>
      <div class="doc-item-v2">
        <div class="doc-item-name"><%= REQUIRED_DOC_LABELS[key] %></div>
        <select class="status-select doc-status" data-project="<%= project.id %>" data-key="<%= key %>">
          <% STATUS_VALUES.forEach(sv => { %>
            <option value="<%= sv %>" <%= d.status === sv ? 'selected' : '' %>><%= STATUS_LABELS[sv] %></option>
          <% }) %>
        </select>
        <input type="text" class="doc-link" data-project="<%= project.id %>" data-key="<%= key %>"
          value="<%= d.link_url || '' %>" placeholder="保存先フォルダ/ファイルのリンク">
        <a class="btn secondary doc-open-link" href="<%= d.link_url || '#' %>" target="_blank" rel="noopener"
          style="<%= d.link_url ? '' : 'visibility:hidden' %>">開く</a>
      </div>
    <% }) %>
  </div>
  <p class="helptext">ステータスは「未着手／作成中／提出済み／修正中」の4段階です。リンク欄には共有サーバー上の保存先（フォルダ/ファイルのパスやURL）を入力してください。ファイルそのものはこの画面には保存されません。</p>
</div>

<div class="card">
  <h2>チェックリスト</h2>
  <% itemsByCategory.forEach(group => { %>
    <div class="checklist-category">
      <h3><%= group.category.name %></h3>
      <% group.items.forEach(item => {
        const st = statusMap[item.id] || 'not_started';
      %>
        <div class="checklist-item-v2">
          <select class="status-select item-status" data-project="<%= project.id %>" data-item="<%= item.id %>">
            <% STATUS_VALUES.forEach(sv => { %>
              <option value="<%= sv %>" <%= st === sv ? 'selected' : '' %>><%= STATUS_LABELS[sv] %></option>
            <% }) %>
          </select>
          <span><%= item.text %><% if (item.note) { %><span class="note">（<%= item.note %>）</span><% } %></span>
        </div>
      <% }) %>
    </div>
  <% }) %>
</div>

<div class="card">
  <h2>更新履歴</h2>
  <ul class="activity-log">
    <% if (activity.length === 0) { %><li>まだ履歴がありません</li><% } %>
    <% activity.forEach(a => { %>
      <li><%= new Date(a.created_at).toLocaleString('ja-JP') %> — <%= a.display_name || '不明' %> — <%= a.detail || a.action %></li>
    <% }) %>
  </ul>
</div>

<script src="/public/app.js"></script>
<%- include('footer') %>
